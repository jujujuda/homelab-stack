# =============================================================================
# Network Stack — Environment Variables
# Services: AdGuard Home, Unbound, WireGuard Easy, Cloudflare DDNS, Nginx Proxy Manager
#
# Usage:
#   cd stacks/network && cp .env.example .env && nano .env
#   docker compose up -d
#
# NOTE: Run ../../scripts/fix-dns-port.sh --check to diagnose port 53 conflicts
#       before starting. systemd-resolved may conflict with AdGuard on port 53.
# =============================================================================

TZ=Asia/Shanghai
DOMAIN=yourdomain.com

# ---------------------------------------------------------------------------
# AdGuard Home — DNS upstream (default: use local Unbound)
# ---------------------------------------------------------------------------
# DNS upstream servers AdGuard forwards to
# Default: local Unbound resolver (recommended for DNSSEC + caching)
# To use external resolvers instead: DNS_UPSTREAMS=1.1.1.1;1.0.0.1
DNS_UPSTREAMS=tcp://unbound:553,udp://unbound:553

# ---------------------------------------------------------------------------
# Unbound — Recursive DNS Resolver
# Runs on port 553 (AdGuard forwards to here)
# ARM64 compatible: linux/arm64/v8
# ---------------------------------------------------------------------------
# No configuration required — uses default settings for homelab use

# ---------------------------------------------------------------------------
# WireGuard Easy — VPN with Web UI
# ARM64 compatible: linux/arm64/v8
# ---------------------------------------------------------------------------
# Public hostname or IP for VPN clients to connect to
WG_HOST=vpn.yourdomain.com

# Web UI password (set this before starting)
WG_PASSWORD=your_wg_password

# WireGuard listen port (default: 51820)
WG_PORT=51820

# VPN client IP range (default: 10.13.0.0/24)
WG_ALLOWED_IPS=10.13.0.0/24

# Per-peer IP assignment base
WG_DEFAULT_ADDRESS=10.13.0.x

# MTU (default: 1420)
WG_MTU=1420

# Max number of peers (default: 5)
WG_PEERS=5

# DNS server pushed to peers (default: WG server IP)
WG_PEER_DNS=10.13.0.1

# Enable web UI (default: true)
WG_ALLOW_WEBUI=true

# ---------------------------------------------------------------------------
# Cloudflare DDNS — Dynamic DNS via Cloudflare API
# ARM64 compatible: linux/arm64/v8
# ---------------------------------------------------------------------------
# Get these from Cloudflare dashboard → My Profile → API Tokens
# Required permissions: Zone.Zone:Read, Zone.DNS:Edit
CF_API_TOKEN=

# Zone ID from Cloudflare dashboard → your domain -> Overview
CF_ZONE_ID=

# Full DNS record to update (e.g., vpn.yourdomain.com or home.yourdomain.com)
# Defaults to WG_HOST if empty
CF_RECORD_NAME=

# ---------------------------------------------------------------------------
# Nginx Proxy Manager
# ---------------------------------------------------------------------------
# Access: http://yourdomain.com:8181
# Default credentials (change on first login):
#   Admin UI:  admin@example.com  / admin123
#   HTTP API:  localhost:81 -> same credentials
# ---------------------------------------------------------------------------
